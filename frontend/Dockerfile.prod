# ---------- Stage 1: build the static assets ----------
ARG NODE_VERSION=24-alpine
FROM node:${NODE_VERSION} AS builder

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# These get baked directly into the compiled JS bundle at build time
ARG VITE_DJANGO_BASE_URL
ARG VITE_DJANGO_WS_URL
ENV VITE_DJANGO_BASE_URL=${VITE_DJANGO_BASE_URL}
ENV VITE_DJANGO_WS_URL=${VITE_DJANGO_WS_URL}

ARG VITE_DJANGO_BASE_URL
RUN echo "BASE URL IS: $VITE_DJANGO_BASE_URL"

RUN npm run build

# ---------- Stage 2: serve with Nginx ----------
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]